rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsRecord() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function validInterests(value) {
      return value is list
        && value.size() <= 12
        && value.hasOnly(['ai', 'programming', 'hardware', 'startups', 'cybersecurity', 'cloud', 'mobile', 'gaming', 'science', 'opensource', 'privacy', 'business']);
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'photoURL', 'interests', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && validInterests(request.resource.data.interests);
    }

    match /savedArticles/{articleId} {
      allow read, delete: if ownsRecord();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'title', 'link', 'image', 'source', 'category', 'savedAt', 'sizeBytes'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.link is string
        && request.resource.data.link.size() <= 2048
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 2048
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 80
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 40
        && request.resource.data.savedAt is string
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes >= 0
        && request.resource.data.sizeBytes <= 104857600;
      allow update: if ownsRecord()
        && request.resource.data.userId == request.auth.uid;
    }
    match /pushSubscriptions/{subscriptionId} {
      allow get, list, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'createdAt'])
        && subscriptionId.matches('^[A-Za-z0-9_-]{20,64}$')
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() <= 8192
        && request.resource.data.endpoint.matches('^https://.*')
        && request.resource.data.p256dh is string
        && request.resource.data.p256dh.size() <= 512
        && request.resource.data.auth is string
        && request.resource.data.auth.size() <= 256
        && request.resource.data.createdAt is timestamp;
    }
  }
}
